# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=5000

# Database engine: mysql (XAMPP, default) or sqlite (single file, no database server; used for the free Render deploy)
DB_CLIENT=mysql

# MySQL / MariaDB (XAMPP defaults: user root, empty password). The database and tables are created automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=security_gateway
# Set to true for hosted MySQL that requires TLS (Aiven, TiDB Cloud, PlanetScale-style hosts)
DB_SSL=false

# Use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh

# Public URL of this app (no trailing slash). Used for OAuth callbacks.
APP_URL=http://localhost:5000

# Comma separated list of origins allowed by CORS (strict allowlist)
CORS_ORIGINS=http://localhost:5000

# Set to false ONLY for plain-http local testing in browsers that reject Secure cookies
COOKIE_SECURE=true

# OAuth (leave blank to disable that provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Create the 3 demo accounts automatically on startup (true/false)
SEED_ON_START=true
